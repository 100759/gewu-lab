---
import Base from '../../layouts/Base.astro';
import items from '../../data/more.json';

export function getStaticPaths() {
  return items.map((it: any) => ({ params: { slug: it.slug }, props: { item: it } }));
}

const { item } = Astro.props as any;
const it = item;
const others = items.filter((x: any) => x.slug !== it.slug);
---

<Base title={it.name} description={it.mainline} noFooter>
  <div class="detail-main">
    <div class="detail-stage">
      <div class="stage-toolbar">
        <span class="crumb" style="margin-right:6px">
          <a href="/more/">更多项目</a> / <b>{it.name}</b>
        </span>
        <span class="st-title">{it.tag}</span>
        <a class="btn-line" href={it.embed} target="_blank" rel="noopener">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 2H2v4M10 14h4v-4M2 2l4.5 4.5M14 14L9.5 9.5"/>
          </svg>
          全屏
        </a>
        <a class="btn-solid" href={it.repo} target="_blank" rel="noopener">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M8 2v9M4.5 8L8 11.5 11.5 8M2 13.5h12"/>
          </svg>
          源码 ↗
        </a>
      </div>
      <div class="frame-wrap">
        <div class="frame-plate">
          <iframe
            src={it.embed}
            title={`${it.name} 交互演示`}
            allow="fullscreen; autoplay"
          ></iframe>
        </div>
        <div class="frame-fig">
          <b>PROJ. {it.slug === 'cell-studio' ? '01' : '02'}</b>
          <span>{it.name}</span>
          <span style="color:var(--ink-4)">—</span>
          <span>{it.author}</span>
        </div>
      </div>
      <div class="frame-note">
        <span>完整程序已在站内运行，不需要跳转</span>
        <span style="color:var(--ink-4)">·</span>
        <span>{it.sizeLabel}</span>
        <span style="color:var(--ink-4)">·</span>
        <span>{it.tech}</span>
      </div>
    </div>

    <aside class="detail-side">
      <h1>{it.name}</h1>
      <p class="sub">{it.mainline}</p>

      <dl class="meta-list">
        <div class="meta-row"><dt>类别</dt><dd>{it.tag}</dd></div>
        <div class="meta-row">
          <dt>作者</dt>
          <dd class="tag"><a href={it.authorUrl} target="_blank" rel="noopener">{it.author}</a></dd>
        </div>
        <div class="meta-row">
          <dt>原仓库</dt>
          <dd class="tag"><a href={it.repo} target="_blank" rel="noopener">GitHub ↗</a></dd>
        </div>
        <div class="meta-row"><dt>许可</dt><dd>{it.licenseShort}</dd></div>
        <div class="meta-row"><dt>体积</dt><dd class="tag">{it.sizeLabel}</dd></div>
        {it.extra.map((e: any) => (
          <div class="meta-row"><dt>{e.k}</dt><dd class="tag">{e.v}</dd></div>
        ))}
      </dl>

      <h3>它是什么</h3>
      <p class="body">{it.desc}</p>

      <h3>课堂上怎么用</h3>
      <p class="body">{it.usage}</p>

      <h3>下一个</h3>
      <nav class="chapter-nav">
        {others.map((o: any) => (
          <a href={`/more/${o.slug}/`}>
            <span class="cn">{o.slug === 'cell-studio' ? '01' : '02'}</span>
            {o.name}
          </a>
        ))}
        <a href="/all/"><span class="cn">—</span>回到教材课件目录</a>
      </nav>

      <div class="license">
        <span class="lic-k">许可</span>
        <span class="lic-v">{it.licenseNote}</span>
      </div>
    </aside>
  </div>
</Base>

<style>
  /* 收录的是独立程序，按视口铺满，不要 global.css 里给教材课件留的 780px 下限 */
  .frame-wrap{min-height:0}
</style>
