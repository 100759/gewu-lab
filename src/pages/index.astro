---
import Base from '../layouts/Base.astro';
import meta from '../data/site-meta.json';

const subjectSlugs: Record<string, string> = { 物理: 'wuli', 化学: 'huaxue', 生物: 'shengwu', 地理: 'dili', 历史: 'lishi', 数学: 'shuxue' };
const subjects = [...meta.subjects].sort((a, b) => a.order - b.order);
---

<Base
  noFooter
  description={`全部开源、纯公益的高中 3D 交互课件库，共 ${meta.lessonCount} 门（物理、化学、生物、地理、历史、数学），打开即演示，可离线下载。`}
>
  <div class="land">

    <section class="hero">
      <div class="lead">
        <div class="kicker">{meta.textbookEdition}</div>
        <h1>高中交互模型库</h1>
        <p class="claim">
          3D 交互课件，按科目、册、章排好。打开即演示——不用装软件、不用联网，投到教室大屏上就能拖、能转、能算。每一步都不先给结论，等学生自己试出来。
        </p>

        <div class="figures">
          <div class="fig"><b>{meta.lessonCount}</b><span>门课件</span></div>
          <div class="fig"><b>{meta.stepCount}</b><span>步交互</span></div>
          <div class="fig"><b>{meta.subjects.length}</b><span>个科目</span></div>
        </div>

        <div class="acts">
          <a class="btn-go" href="/all/">进入课件目录 <span aria-hidden="true">→</span></a>
          <a class="link-quiet" href="/about/">授权与使用说明</a>
          <span class="note">可下载离线使用</span>
        </div>
      </div>

      <figure class="specimen" data-scene>
        <div class="scene-box">
          <img
            class="poster"
            src="/img/cell-model.webp"
            width="920"
            height="835"
            alt="动物细胞三维模型"
            decoding="async"
            fetchpriority="high"
          />
          <canvas
            class="scene-canvas"
            aria-label="动物细胞三维模型，可用鼠标拖动旋转"
          ></canvas>
        </div>
        <figcaption class="spec-cap">
          <b>模型示意 · 动物细胞</b>
          真核细胞 · 异养生物 · 直径 10–30 微米
        </figcaption>
      </figure>
    </section>

    <nav class="subjects" aria-label="按科目浏览">
      {subjects.map((s, i) => (
        <a class="subj" href={`/${subjectSlugs[s.name]}/`}>
          <span class="subj-no">0{i + 1}</span>
          <span class="subj-name">{s.name}</span>
          <span class="subj-cnt">{s.count > 0 ? `${s.count} 门` : '待收录'}</span>
        </a>
      ))}
    </nav>


    <div class="colophon">
      <div class="c-left">
        课件内容开源、免费、公益 · 部分从网上收集或老师投稿，如有侵权请联系删除
      </div>
      <div class="c-right">
        纯公益，永久免费，不接广告　·　<a href="/submit/">欢迎各位老师分享与投稿</a>
      </div>
    </div>

  </div>
</Base>

<style>
  .land{
    min-height:calc(100vh - 64px);
    display:flex;flex-direction:column;
  }

  /* ---------- 首屏 ---------- */
  .hero{
    flex:1;display:grid;
    grid-template-columns:minmax(0,1fr) 460px;
    gap:60px;align-items:center;
    padding:24px 40px 0;
  }
  .lead{min-width:0}

  .kicker{
    font-family:var(--mono);font-size:11px;letter-spacing:.14em;
    color:var(--ink-3);margin-bottom:16px;
  }
  h1{
    font-family:var(--serif);font-size:50px;font-weight:600;
    letter-spacing:.02em;line-height:1.15;
  }
  .claim{
    font-size:14.5px;color:var(--ink-2);line-height:2;
    margin-top:18px;max-width:580px;
  }

  .figures{
    display:flex;margin-top:26px;border-top:1px solid var(--line);max-width:520px;
  }
  .fig{flex:1;padding-top:15px;border-right:1px solid var(--line)}
  .fig + .fig{padding-left:22px}
  .fig:last-child{border-right:0}
  .fig b{
    display:block;font-family:var(--mono);font-size:23px;font-weight:500;
    line-height:1.2;letter-spacing:.02em;
  }
  .fig span{
    display:block;font-family:var(--mono);font-size:10px;color:var(--ink-4);
    letter-spacing:.11em;margin-top:3px;
  }

  .acts{display:flex;align-items:center;gap:14px 22px;margin-top:26px;flex-wrap:wrap}
  .btn-go{
    height:40px;padding:0 20px;border:1px solid var(--ink);background:var(--ink);
    color:var(--paper);border-radius:2px;text-decoration:none;
    font-size:13.5px;display:inline-flex;align-items:center;gap:8px;
    transition:background .16s,border-color .16s;
  }
  .btn-go:hover{background:var(--red);border-color:var(--red)}
  .link-quiet{
    font-size:13px;color:var(--ink-3);text-decoration:none;
    border-bottom:1px solid var(--line-2);padding-bottom:1px;
    transition:color .16s,border-color .16s;
  }
  .link-quiet:hover{color:var(--red);border-color:var(--red)}
  .note{font-family:var(--mono);font-size:10.5px;color:var(--ink-4);letter-spacing:.05em}

  /* 图版：模型直接浮在纸面上，只给脚下一点柔光 */
  .specimen{position:relative;margin:0}
  .specimen::before{
    content:"";position:absolute;left:10%;right:16%;top:83%;height:11%;
    background:radial-gradient(50% 50% at 50% 50%,rgba(28,27,24,.13),rgba(28,27,24,0) 72%);
    filter:blur(14px);
  }
  .scene-box{position:relative;width:100%;aspect-ratio:920/835}
  .specimen .poster{
    position:absolute;inset:0;width:100%;height:100%;object-fit:contain;
    transition:opacity .55s ease;
  }
  .scene-canvas{
    position:absolute;inset:0;width:100%;height:100%;display:block;
    opacity:0;transition:opacity .55s ease;cursor:grab;touch-action:pan-y;
  }
  .scene-canvas:active{cursor:grabbing}
  .specimen.is-live .poster{opacity:0}
  .specimen.is-live .scene-canvas{opacity:1}
  .spec-cap{
    position:relative;margin-top:2px;
    font-family:var(--mono);font-size:10px;line-height:1.7;
    letter-spacing:.07em;color:var(--ink-4);
  }
  .spec-cap b{color:var(--ink-3);font-weight:500;display:block}

  /* ---------- 科目索引 ---------- */
  .subjects{
    flex:0 0 auto;display:grid;grid-template-columns:repeat(6,1fr);
    border-top:1px solid var(--line);margin:0 40px;
  }
  .subj{
    display:flex;align-items:baseline;gap:13px;
    padding:17px 0 15px 26px;border-right:1px solid var(--line);
    text-decoration:none;color:inherit;transition:background .16s;
  }
  .subj:first-child{padding-left:0}
  .subj:last-child{border-right:0}
  .subj:hover{background:var(--paper-2)}
  .subj:hover .subj-name{color:var(--red)}
  .subj-no{font-family:var(--mono);font-size:10px;color:var(--ink-4);letter-spacing:.1em}
  .subj-name{
    font-family:var(--serif);font-size:20px;font-weight:600;
    letter-spacing:.04em;transition:color .16s;
  }
  .subj-cnt{font-family:var(--mono);font-size:10.5px;color:var(--ink-4);letter-spacing:.04em}


  /* ---------- 版权条 ---------- */
  .colophon{
    flex:0 0 auto;display:flex;align-items:baseline;gap:24px;
    padding:15px 40px 20px;font-size:12px;color:var(--ink-3);line-height:1.7;
    flex-wrap:wrap;
  }
  .c-left{font-family:var(--mono);font-size:11px;letter-spacing:.04em}
  .c-left a,.c-right a{color:inherit;text-decoration:none;border-bottom:1px solid var(--line-2)}
  .c-left a:hover,.c-right a:hover{color:var(--red);border-color:var(--red)}
  .c-right{margin-left:auto;text-align:right}

  /* ---------- 响应式 ---------- */
  @media(max-width:1100px){
    .hero{grid-template-columns:minmax(0,1fr) 380px;gap:40px}
    h1{font-size:44px}
    .subjects{margin:0 40px}
  }
  @media(max-width:900px){
    .hero{
      grid-template-columns:1fr;gap:24px;align-items:start;
      padding:36px 20px 8px;
    }
    h1{font-size:32px}
    .claim{font-size:13.5px;line-height:1.9;margin-top:14px}
    .figures{max-width:none;margin-top:20px}
    .acts{margin-top:20px;gap:16px}
    .specimen{width:100%;max-width:340px;margin:12px auto 0}
    /* 两列六格：左列贴齐、右列留缩进，除最后一行外都有横线 */
    .subjects{grid-template-columns:repeat(2,1fr);margin:0 20px}
    .subj{padding:14px 0 12px 18px}
    .subj:nth-child(odd){padding-left:0}
    .subj:nth-child(even){border-right:0}
    .subj:not(:nth-last-child(-n+2)){border-bottom:1px solid var(--line)}
    .colophon{padding:14px 20px 18px;font-size:11.5px;gap:10px}
    .c-right{margin-left:0;text-align:left}
  }
  @media(max-width:620px){
    h1{font-size:28px}
    .kicker{font-size:10px;margin-bottom:12px}
    .fig b{font-size:20px}
    .specimen{max-width:300px}
  }
</style>
<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';

  const wrap = document.querySelector('.specimen[data-scene]') as HTMLElement | null;
  const boxEl = wrap?.querySelector('.scene-box') as HTMLElement | null;
  const canvas = wrap?.querySelector('canvas') as HTMLCanvasElement | null;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = matchMedia('(max-width: 640px)').matches;

  if (wrap && boxEl && canvas && !reduced && !narrow) build();

  function build() {
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 400);

    scene.add(new THREE.HemisphereLight(0xffffff, 0xe8e1d4, 1.25));
    const key = new THREE.DirectionalLight(0xffffff, 1.45); key.position.set(2.6, 4.2, 3.4); scene.add(key);
    const fill = new THREE.DirectionalLight(0xfff2e6, 0.75); fill.position.set(-3.6, 1.4, -2.2); scene.add(fill);
    const rim = new THREE.DirectionalLight(0xffffff, 0.5); rim.position.set(0, -2.6, 2.4); scene.add(rim);

    const pivot = new THREE.Group();
    scene.add(pivot);

    let ready = false;
    let running = true;
    // 剖面朝前的角度，模型绕这个角度小幅摆动，始终看得到细胞内部
    let baseYaw = -1.58;
    let swayPhase = 0.4;
    let tiltX = 0, tiltY = 0, targetX = 0, targetY = 0;
    let dragging = false, dragX = 0, last = 0;

    const resize = () => {
      const r = boxEl!.getBoundingClientRect();
      if (!r.width || !r.height) return;
      renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
      renderer.setSize(Math.round(r.width), Math.round(r.height), false);
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(boxEl!);
    resize();

    const loader = new GLTFLoader();
    loader.setDRACOLoader(new DRACOLoader().setDecoderPath('/draco/'));
    loader.load(
      '/img/cell-scene.glb',
      (gltf) => {
        const model = gltf.scene;
        model.traverse((o: any) => {
          if (o.isMesh) {
            o.material.side = THREE.DoubleSide;
            o.material.roughness = Math.min(o.material.roughness ?? 0.85, 0.9);
          }
        });
        const bb = new THREE.Box3().setFromObject(model);
        const size = bb.getSize(new THREE.Vector3());
        const center = bb.getCenter(new THREE.Vector3());
        model.position.sub(center);
        pivot.add(model);

        const radius = 0.5 * Math.max(size.x, size.y, size.z);
        const dist = (radius / Math.sin(THREE.MathUtils.degToRad(30) / 2)) * 1.04;
        camera.position.set(0, 0, dist);
        camera.lookAt(0, 0, 0);

        ready = true;
        requestAnimationFrame(() => wrap!.classList.add('is-live'));
      },
      undefined,
      () => { /* 初始化失败就保留静态图 */ }
    );

    boxEl!.addEventListener('pointermove', (e) => {
      const r = boxEl!.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      if (dragging) {
        baseYaw += (e.clientX - dragX) * 0.007;
        dragX = e.clientX;
        targetX = 0; targetY = 0;
      } else {
        targetY = nx * 1.15;
        targetX = ny * -0.45;
      }
    });
    boxEl!.addEventListener('pointerleave', () => { targetX = 0; targetY = 0; });
    boxEl!.addEventListener('pointerdown', (e) => { dragging = true; dragX = e.clientX; canvas.setPointerCapture(e.pointerId); });
    boxEl!.addEventListener('pointerup', (e) => { dragging = false; canvas.releasePointerCapture?.(e.pointerId); });

    new IntersectionObserver((es) => {
      running = es[0].isIntersecting;
      if (running) { last = 0; requestAnimationFrame(tick); }
    }, { threshold: 0.15 }).observe(boxEl!);

    function tick(t: number) {
      if (!running) return;
      const dt = Math.min(48, last ? t - last : 16);
      last = t;
      if (ready) {
        if (!dragging) swayPhase += dt * 0.0009;
        const sway = Math.sin(swayPhase) * 0.34;
        tiltY += (targetY - tiltY) * 0.07;
        tiltX += (targetX - tiltX) * 0.07;
        pivot.rotation.set(0.05 + tiltX, baseYaw + sway + tiltY, 0, 'YZX');
        renderer.render(scene, camera);
      }
      requestAnimationFrame(tick);
    }
  }
</script>
